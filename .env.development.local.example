# Local Supabase runs from `pnpm supabase:start`.
# The local CLI may provide a legacy-format key, but it fills the app's public-key variable.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copy-local-public-key-from-supabase-status
NEXT_PUBLIC_SUPABASE_BOARD_ID=dev-product-launch
