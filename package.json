{
  "name": "kanban-board",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "pnpm supabase:start && pnpm supabase:env && pnpm dev",
    "dev:local:reset": "pnpm supabase:start && pnpm supabase:reset && pnpm supabase:env && pnpm dev",
    "build": "next build",
    "build:production": "pnpm db:push:production && pnpm build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "start": "npx serve@latest out -l 3000",
    "lint": "next lint",
    "test:e2e:dev": "playwright test",
    "db:seed": "node scripts/seed-supabase-board.mjs",
    "db:push:production": "node scripts/push-production-schema.mjs",
    "db:seed:dev": "supabase db reset",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:env": "node scripts/write-local-supabase-env.mjs",
    "supabase:dump:seed": "supabase db dump --local --schema public --data-only -f supabase/seed.sql"
  },
  "dependencies": {
    "@hello-pangea/dnd": "18.0.1",
    "@supabase/supabase-js": "^2.107.0",
    "nanoid": "^5.0.7",
    "next": "14.2.5",
    "next-themes": "^0.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "24.7.2",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.38",
    "supabase": "^2.109.1",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.4.5"
  }
}
