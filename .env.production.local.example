NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-production-key
NEXT_PUBLIC_SUPABASE_BOARD_ID=default
# Build-only administrative connection used to apply production migrations.
# Keep this secret and never rename it with a NEXT_PUBLIC_ prefix.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-percent-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres
